# ──────────────────────────────────────────────────────────
#  ReqLab — configuración de entorno
#  Copie este archivo como .env y complete los valores.
# ──────────────────────────────────────────────────────────

# ── LLM ────────────────────────────────────────────────────
# Proveedor que exponga el contrato OpenAI Chat Completions con autenticación Bearer.
# DeepSeek es la configuración validada por el prototipo. Otros proveedores pueden
# requerir un adaptador propio para URL, autenticación o formato de respuesta.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_RETRIES=3

# Retrocompatibilidad (equivalentes a LLM_*; se usan si LLM_* no están definidas).
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── Embeddings ──────────────────────────────────────────────
# Modelo local de sentence-transformers para la búsqueda semántica.
# Opciones recomendadas:
#   paraphrase-multilingual-MiniLM-L12-v2  → rápido, liviano
#   intfloat/multilingual-e5-base           → recuperación multilingüe equilibrada (seleccionado)
#   BAAI/bge-m3                             → excelente, requiere más RAM
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Prefijos necesarios para modelos e5 y bge (se detectan automáticamente si el
# nombre contiene "e5"; configúrelos manualmente para otros modelos que los requieran).
# EMBEDDING_QUERY_PREFIX=query:
# EMBEDDING_PASSAGE_PREFIX=passage:

# ── Reranker (opcional) ─────────────────────────────────────
# Un cross-encoder mejora la precisión del RAG reordenando los candidatos del RRF.
# Requiere sentence-transformers instalado (ya incluido en requirements.txt).
# Disponible para pruebas controladas. Se mantiene desactivado porque la calibración
# inicial no mostró una mejora consistente frente al costo de latencia.
RERANKER_ENABLED=False
# La UI de Proyectos guarda la selección en SQLite y prevalece sobre estos valores.
RERANKER_PROVIDER=local
# Modelo multilingüe adecuado para corpus en español.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
JEV_MODEL=typesafe/jev-1.13

# ── Recuperación híbrida (RRF) ──────────────────────────────
# Pesos del Reciprocal Rank Fusion (deben sumar ≈ 1.0).
RRF_LEXICAL_WEIGHT=0.45
RRF_SEMANTIC_WEIGHT=0.55
# Número de fragmentos que recibe el LLM por generación de artefacto.
RETRIEVAL_TOP_K=12

# Umbrales heurísticos que deben calibrarse con el caso de evaluación.
DUPLICATE_THRESHOLD=0.72
CROSS_TYPE_DUPLICATE_THRESHOLD=0.55

# Identificador de la versión de instrucciones usada en una ejecución.
PROMPT_VERSION=reqlab-v2

# ── Validación semántica con Jev (piloto opcional) ──────────
# En modo shadow los resultados se almacenan por separado y nunca modifican,
# aprueban ni rechazan artefactos. Se ejecuta solo desde su endpoint explícito.
SEMANTIC_VALIDATION_ENABLED=False
SEMANTIC_VALIDATION_MODE=shadow
# Se acepta OPENROUTER_API_KEY; TYPESAFE_API_KEY permanece como alias compatible.
OPENROUTER_API_KEY=
# La clave disponible para este piloto es de OpenRouter. Jev se sirve mediante
# su endpoint experimental de decisiones, no mediante /chat/completions.
TYPESAFE_BASE_URL=https://openrouter.ai/api
TYPESAFE_ENDPOINT_PATH=/alpha/decisions
# Se fija el modelo para que un alias móvil no cambie el experimento.
TYPESAFE_MODEL=typesafe/jev-1.13
SEMANTIC_TIMEOUT_SECONDS=15
SEMANTIC_MAX_ATTEMPTS=2
SEMANTIC_PROMPT_VERSION=jev-evidence-v1
# Manténgalo vacío hasta calibrarlo con el conjunto de desarrollo.
SEMANTIC_CONFIDENCE_THRESHOLD=

# ── Segmentación ────────────────────────────────────────────
# Tamaño máximo de cada fragmento en caracteres.
CHUNK_SIZE=1200
# Solapamiento entre fragmentos consecutivos (debe ser < CHUNK_SIZE).
CHUNK_OVERLAP=180

# ── Almacenamiento ──────────────────────────────────────────
DATA_DIR=./data

# ── API ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
MAX_UPLOAD_BYTES=20971520

# ── Telemetría ──────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False
